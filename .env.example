# Copy to .env (git-ignored) and fill in only what you use. Never commit a filled-in .env.
# Optional LLM planner (DeepSeek official API). Leave empty to run without it.
DEEPSEEK_API_KEY=
# Host user for the container's files (run `id -u` and `id -g`).
HOST_UID=1000
HOST_GID=1000
# 1 = include the optional angr solver in the image; 0 = smaller image without it.
WITH_SOLVER=1
# Scope manifest to load (kept out of git; see scope.example.yaml).
SCOPE_FILE=./scope-hackathon.yaml
